# Copy to `.env.local` (gitignored) and fill in the values.
# Expo inlines every EXPO_PUBLIC_* variable into the client bundle, so never
# put secrets in them. Keep this file in sync when adding a new variable.

# --- Clerk (auth) ---------------------------------------------------------
# Publishable key from https://dashboard.clerk.com (required).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Google sign-in client IDs, read by @clerk/expo. app.json `extra` already
# ships the production values; only set these to override them locally.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
# (iOS only) The iOS client ID reversed, e.g.
# com.googleusercontent.apps.<part of the iOS client ID before .apps.googleusercontent.com>
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
# Base URL for email sign-in links. Defaults to https://chompgrocery.com.
# EXPO_PUBLIC_EMAIL_LINK_BASE_URL=

# --- Instant (database) ---------------------------------------------------
# App id from https://instantdb.com/dash (required).
EXPO_PUBLIC_INSTANT_APP_ID=
# Name of the Clerk client configured in the Instant dashboard (required).
EXPO_PUBLIC_INSTANT_CLIENT_NAME=
# Admin token for the app above. Only used by node scripts and instant-cli
# (`pnpm check-instant`, `pnpm push-schema`, scripts/*.mjs), never the app.
INSTANT_APP_ADMIN_TOKEN=

# --- Chomp API ------------------------------------------------------------
# Recipe parsing, account deletion and share links (required for those flows).
EXPO_PUBLIC_API_URL=

# --- Dev-only flags -------------------------------------------------------
# Recipe import: use a local mock instead of the parse API (ignored outside
# __DEV__). Paste https://mock.test/success, /slow, /empty, or any error code
# as the path. See features/recipes/api/mock-parse-recipe-url.ts.
# EXPO_PUBLIC_MOCK_RECIPE_IMPORT=true

# SDK tests: use a separate .env.test.local with matching public/admin credentials.
# Both current and former production app IDs are rejected.
# INSTANT_TEST_APP_ID=
