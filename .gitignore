# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Package managers
package-lock.json
yarn.lock
pnpm-debug.log*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# scratch output from local scripts (e.g. pnpm check-instant)
/tmp/

# Sensitive production snapshots; retain locally, never commit.
/backups/

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
