{
  "expo": {
    "name": "Chomp",
    "slug": "chomp",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chomp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ethangrebmeier.chomp",
      "associatedDomains": ["applinks:chompgrocery.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "K8MV5DQ32C"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ethangrebmeier.chomp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ECEDDB"
        }
      ],
      "expo-sqlite",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/averia-serif-libre/400Regular/AveriaSerifLibre_400Regular.ttf",
              "node_modules/@expo-google-fonts/jaro/400Regular/Jaro_400Regular.ttf",
              "assets/fonts/alpino/Alpino-Regular.otf",
              "assets/fonts/alpino/Alpino-Medium.otf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "AveriaSerifLibre-Regular",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/averia-serif-libre/400Regular/AveriaSerifLibre_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Jaro-Regular",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/jaro/400Regular/Jaro_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Alpino-Regular",
                "fontDefinitions": [
                  {
                    "path": "assets/fonts/alpino/Alpino-Regular.otf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Alpino-Medium",
                "fontDefinitions": [
                  {
                    "path": "assets/fonts/alpino/Alpino-Medium.otf",
                    "weight": 500
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-image",
      "expo-status-bar",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eaca5365-c88e-4712-b89c-b3f737a6cde5"
      },
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "588662563984-e215s7s4qvpilsm05vrlolimpe18r1it.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID": "588662563984-q7st72u4inr2dl2bpb1967uvvs0r09g9.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.588662563984-q7st72u4inr2dl2bpb1967uvvs0r09g9"
    },
    "owner": "ethangrebmeier",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eaca5365-c88e-4712-b89c-b3f737a6cde5"
    }
  }
}
