{
  "expo": {
    "name": "Chomp",
    "slug": "chomp",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chomp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ethangrebmeier.chomp",
      "associatedDomains": ["applinks:chompgrocery.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ethangrebmeier.chomp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ECEDDB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you select them as recipe images."
        }
      ],
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/averia-serif-libre/400Regular/AveriaSerifLibre_400Regular.ttf",
            "node_modules/@expo-google-fonts/jaro/400Regular/Jaro_400Regular.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eaca5365-c88e-4712-b89c-b3f737a6cde5"
      }
    },
    "owner": "ethangrebmeier",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eaca5365-c88e-4712-b89c-b3f737a6cde5"
    }
  }
}
